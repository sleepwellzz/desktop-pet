{
  "name": "desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "自研 Windows 桌面宠物运行时：解析 Codex/ChatGPT 宠物包，把 agent 活动状态可视化为可交互桌宠",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:preload-bubble && npm run build:preload-bar && npm run build:renderer && npm run build:bubble && npm run build:bar && node tools/copy-assets.mjs",
    "build:main": "tsc -p tsconfig.json",
    "build:preload": "esbuild src/main/preload.ts --bundle --outfile=dist/main/preload.js --format=cjs --platform=node --external:electron",
    "build:preload-bubble": "esbuild src/main/preload-bubble.ts --bundle --outfile=dist/main/bubble-preload.js --format=cjs --platform=node --external:electron",
    "build:preload-bar": "esbuild src/main/preload-bar.ts --bundle --outfile=dist/main/bar-preload.js --format=cjs --platform=node --external:electron",
    "build:renderer": "esbuild src/renderer/renderer.ts --bundle --outfile=dist/renderer/renderer.js --format=iife --target=es2022 --sourcemap",
    "build:bubble": "esbuild src/renderer/bubble.ts --bundle --outfile=dist/renderer/bubble.js --format=iife --target=es2022 --sourcemap",
    "build:bar": "esbuild src/renderer/control-bar.ts --bundle --outfile=dist/renderer/control-bar.js --format=iife --target=es2022 --sourcemap",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.preload.json",
    "typecheck:preload": "tsc -p tsconfig.preload.json",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test:status": "node tools/status-arbiter.test.mjs",
    "e2e:status": "node spikes/m2-status/run-status-e2e.mjs",
    "pet:validate": "python tools/validate_pet.py",
    "check:timers": "node tools/check-timers.mjs",
    "make:portable": "node tools/make-portable.mjs"
  },
  "devDependencies": {
    "electron": "44.4.0",
    "esbuild": "^0.28.2",
    "rcedit": "^5.0.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "koffi": "^3.3.0"
  }
}
